# Emmanuel CliniX — environment variables. Copy to `.env.local`.

# ── GoHighLevel ──────────────────────────────────────────────────────────────
# Default inbound webhook — EVERY form on the site posts here (server-side),
# unless a more specific webhook below is set for that form group.
GHL_WEBHOOK_URL=
# Optional per-group overrides (leave empty to use GHL_WEBHOOK_URL):
GHL_WEBHOOK_URL_QUIZ=        # the 9 self-assessment tests
GHL_WEBHOOK_URL_BRAINMAP=    # /brainmap general VSL page + the condition LPs (/lp/*)
GHL_WEBHOOK_URL_EMSELLA=     # /lp/emsella
GHL_WEBHOOK_URL_NEUROFIT=    # /neurofit (NeuroFit first-experience booking)
GHL_WEBHOOK_URL_CONTACT=     # contact / "call me" forms

# ── Domains (one codebase, two domains) ──────────────────────────────────────
# .ro serves Romanian by default, .co.uk serves English by default.
# Visitors can switch language at any time (saved in a cookie).
NEXT_PUBLIC_SITE_URL_RO=https://emmanuelclinix.ro
NEXT_PUBLIC_SITE_URL_EN=https://emmanuelclinix.co.uk
# Language used on hosts that are neither .ro nor .co.uk (localhost, previews).
DEFAULT_LOCALE=ro

# ── Optional ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
# Google Ads conversion (fires on every successful lead)
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_CONVERSION_LABEL=
NEXT_PUBLIC_CLARITY_ID=
# GoHighLevel calendar embed URL used by /lp/emsella.
NEXT_PUBLIC_GHL_BOOKING_URL=
# Website AI assistant (/api/chat). Without it the chat shows phone + WhatsApp instead.
ANTHROPIC_API_KEY=

# ── Search engines (SEO / GEO) ───────────────────────────────────────────────
# Ownership tags. Leave empty to omit. Set BEFORE building (read at build time).
# Google Search Console → Add property → "URL prefix" → HTML tag → copy the
# `content` value. (A "Domain" property verified by DNS needs nothing here.)
GOOGLE_SITE_VERIFICATION=
# Optional: a different Google code for the .co.uk domain.
GOOGLE_SITE_VERIFICATION_EN=
# Bing Webmaster Tools → Add site → "HTML Meta Tag" → copy the `content` value
# of <meta name="msvalidate.01">. (Or use "Import from Google Search Console".)
BING_SITE_VERIFICATION=
# Optional: a different Bing code for the .co.uk domain.
BING_SITE_VERIFICATION_EN=
# IndexNow (instant indexing on Bing and other engines). Any 8–128 character
# string of a–z, A–Z, 0–9 and "-" — e.g. `openssl rand -hex 16`. Served at
# /indexnow-key.txt; ping with `node --env-file=.env.local scripts/indexnow.mjs`.
INDEXNOW_KEY=

# ── /admin (control panel: service videos + testimonials) ────────────────────
# Password for https://<site>/admin — at least 8 characters, use a long one.
# Changing it logs everyone out.
ADMIN_PASSWORD=
# Storage for /admin. On Vercel: Storage → "Upstash for Redis" → Create →
# Connect to this project. Vercel fills these in by itself. Locally, leave them
# empty and /admin saves to .data/cms.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Video file uploads from /admin (Vercel Blob). On Vercel: Storage → Blob →
# Create (PUBLIC access) → Connect to this project; Vercel fills these in.
# Without them /admin still accepts YouTube / Vimeo / .mp4 links.
BLOB_READ_WRITE_TOKEN=
# (Stores connected with OIDC only set this one instead of the token.)
BLOB_STORE_ID=
